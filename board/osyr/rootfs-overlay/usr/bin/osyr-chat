#!/usr/bin/env python3
"""OSYR — agent console (milestone 0, with the v0 agent from milestone 1).

Talks to the active provider (the local model or an external one) and can use two
tools: 'osyr' (the system CLI, with its JSON contract) and 'look'
(look at the screen). Whatever changes the system asks for confirmation;
queries do not. Voice: Super+Space (osyr-voice) or /voice; answers to
voice are read aloud. Conversations are saved and /resume picks them
up again. Standard library only: the image does not ship requests.
"""
import getpass
import hashlib
import json
import os
import random
import readline  # noqa: F401  (history and line editing in input())
import shlex
import signal
import subprocess
import sys
import termios
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.environ.get("OSYR_LIB", "/usr/lib/osyr"))
from osyr import ai as aiconf  # noqa: E402  (active provider: local or external)
from osyr import cli as osyr_cli  # noqa: E402  (validate commands before running them)
from osyr import look as looker  # noqa: E402
from osyr import memory  # noqa: E402  (what the person asked to remember)
from osyr import net as osyrnet  # noqa: E402  (exact name of the wifi network)
from osyr import live  # noqa: E402  (update without restarting)
from osyr import voice  # noqa: E402

PORT = os.environ.get("OSYR_LLAMA_PORT", "8083")
SLOT = 0  # local model slot for the chat; /look and diag use slot 1 (see osyr-llama)
BASE = f"http://127.0.0.1:{PORT}"
MAX_REPLY = 2048     # maximum reply tokens
HISTORY_SHARE = 0.75  # the conversation fits in 75% of the context
MAX_STEPS = 6        # tool calls in a row within one turn
TOOL_OUTPUT = 4000   # characters of tool output the model sees (~1,000 tokens)
CHATS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                     "osyr", "chats")
# Technical chat log (collected by osyr-diag): provider, timings, errors with the
# server's reason and tools used. Never the conversation text or the command
# arguments (only their first two words: "net status").
LOG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                   "osyr", "chat.log")
LOG_MAX = 512 * 1024


def dbg(event, **kw):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_MAX:
            os.replace(LOG, LOG + ".old")
        with open(LOG, "a") as f:
            f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S"), "event": event, **kw},
                               ensure_ascii=False) + "\n")
    except OSError:
        pass


def pinfo(p):
    """The provider without its key: name, model and server."""
    return {"provider": p.get("name"), "model": p.get("model") or "local", "local": p.get("local"),
            "host": urllib.parse.urlparse(p.get("url") or "").netloc}


SYSTEM = (
    "You are OSYR, the assistant built into this operating system. "
    "Answer briefly and in the user's language. "
    "For anything about this computer (network and wifi, sound, screen brightness, "
    "AI settings, updates) use the osyr tool and base your answer on its JSON result; "
    "never invent results. If a result has a hint, follow it or tell the user. "
    "Use the look tool when the user asks about what is on the screen, and the clipboard "
    "tool when they mention what they copied or want something copied. "
    "If something is not among your tools' commands, OSYR cannot do it yet: say so "
    "plainly and do not invent steps. To install OSYR on the computer's disk, tell the user to "
    "type /install in this chat while OSYR runs from the USB: it asks for their password, the "
    "disk (the whole disk is erased) and whether to encrypt their files (then a passphrase is "
    "asked at every start-up), and copies the system and their files. You cannot run it for them. "
    "OSYR updates: tell the user to type /update in this chat (it shows what would change and "
    "asks before applying; /update undo puts back the previous version). You cannot apply them. "
    "If the user reports a problem with OSYR or the computer that you cannot solve, suggest "
    "typing /report: it asks what happened and sends logs and hardware data to the OSYR team "
    "(conversations only if the user turns that on or types /report chats). "
    "For how to do something in OSYR, read the help with the osyr tool ('doc <words>') "
    "and answer from it; for the full help, tell them to press Super+F1. "
    "When the user asks you to remember something about them, save it with the remember tool."
)


def system_prompt(local=True):
    """SYSTEM and, with the local model, what the person asked to remember. It is
    built on every request: what was saved applies from the next message, and it
    is never sent to a remote provider (it is personal data)."""
    return SYSTEM + (memory.prompt_block() if local else "")
