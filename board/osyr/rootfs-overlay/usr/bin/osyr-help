#!/usr/bin/env python3
"""OSYR — help in the terminal (Super+F1): /usr/share/osyr/help.md in colour.

The same help is the page https://ccmai.org/osyr/help.html (generated by
scripts/render-web.py from the same file). On a terminal it opens in less (q
to quit); otherwise it is printed.
Usage: osyr-help [--plain]
"""
import os
import re
import shutil
import subprocess
import sys

HELP = os.environ.get("OSYR_HELP", "/usr/share/osyr/help.md")
BRIGHT, GREEN, DIM, BOLD, RESET = "\033[92m", "\033[32m", "\033[2;32m", "\033[1m", "\033[0m"


def table(rows, color):
    """Markdown table -> aligned columns; the first row is the header."""
    cells = [[c.strip() for c in r.strip().strip("|").split("|")] for r in rows]
    cells = [r for r in cells if not all(set(c) <= set("-: ") for c in r)]
    width = min(max(len(strip(r[0])) for r in cells), 36)
    out = []
    for i, r in enumerate(cells):
        left, right = r[0], " | ".join(r[1:])
        pad = " " * max(1, width - len(strip(left)) + 2)
        if i == 0:
            out.append(f"  {DIM if color else ''}{left}{pad}{right}{RESET if color else ''}")
        elif len(strip(left)) > width:  # too long: the description goes on the next line
            out.append(f"  {inline(left, color)}")
            out.append(f"  {' ' * (width + 2)}{inline(right, color)}")
        else:
            out.append(f"  {inline(left, color)}{pad}{inline(right, color)}")
    return out


def strip(text):
    return text.replace("`", "")


def inline(text, color):
    if not color:
        return strip(text)
    return re.sub(r"`([^`]*)`", lambda m: f"{BRIGHT}{m.group(1)}{RESET}", text)


def render(md, color):
    out, rows = [], []
    for line in md.splitlines() + [""]:
        if line.startswith("|"):
            rows.append(line)
            continue
        if rows:
            out += table(rows, color)
            rows = []
        if line.startswith("# "):
            title = line[2:].upper()
            out += [f"{BOLD}{BRIGHT}{title}{RESET}" if color else title, ""]
        elif line.startswith("## "):
            title = line[3:]
            out += ["", f"{BOLD}{BRIGHT}{title}{RESET}" if color else title,
                    f"{DIM}{'─' * len(title)}{RESET}" if color else "-" * len(title)]
        elif line.startswith("- "):
            out.append(f"  {GREEN if color else ''}›{RESET if color else ''} {inline(line[2:], color)}")
        else:
            out.append(inline(line, color))
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip() + "\n"


def main():
    plain = "--plain" in sys.argv
    try:
        md = open(HELP).read()
    except OSError as e:
        print(f"No help file: {e}", file=sys.stderr)
        return 1
    tty = sys.stdout.isatty() and not plain
    text = render(md, tty)
    if tty and shutil.which("less"):
        # no -F: with Super+F1 the window would close at once if the page fits
        subprocess.run(["less", "-R", "-P", "OSYR help -- arrows to scroll, q to close"], input=text, text=True)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
