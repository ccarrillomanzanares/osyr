#!/usr/bin/env python3
"""OSYR — push to talk (Super+Space in sway).

  osyr-voice start            starts recording (on key press)
  osyr-voice stop             stops, transcribes and sends it to the chat (on release)
  osyr-voice dictate          stops, transcribes and types it into the active window
                              (Super+Ctrl+Space: dictation in any application)
  osyr-voice transcribe FILE  only transcribes a WAV (tests)
"""
import os
import subprocess
import sys

sys.path.insert(0, os.environ.get("OSYR_LIB", "/usr/lib/osyr"))
from osyr import notify, voice  # noqa: E402


def dictate():
    """Types the dictated text into the focused window (wtype)."""
    wav = voice.stop()
    if not wav:
        return 0
    notify.send("Dictation", "Transcribing...", "low", timeout_ms=3000)
    try:
        text, _ = voice.transcribe(wav)
    except (RuntimeError, OSError) as e:
        notify.send("Dictation failed", str(e))
        return 1
    if not text:
        return 0
    p = subprocess.run(["wtype", "--", text + " "], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        notify.send("Dictation failed", p.stderr.strip() or "wtype failed")
        return 1
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "start":
        voice.start()
        return 0
    if cmd == "dictate":
        return dictate()
    if cmd in ("stop", "transcribe"):
        wav = voice.stop() if cmd == "stop" else (sys.argv[2] if len(sys.argv) > 2 else None)
        if not wav:
            return 0  # press too short: nothing to do
        try:
            text, lang = voice.transcribe(wav)
        except (RuntimeError, OSError) as e:
            print(f"osyr-voice: {e}", file=sys.stderr)
            return 1
        if cmd == "transcribe":
            print(f"[{lang}] {text}")
            return 0
        if text and not voice.deliver(text, lang):
            voice.speak("No chat window is open." if lang != "es" else "No hay ninguna ventana de chat abierta.", lang)
            return 1
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
