# =============================================================================
# OSYR — kernel fragment (x86_64), applied on top of kernel_base.config
#
# Inherited from newos, where every line was verified by booting real hardware.
# RULE: drivers are not listed here. Drivers come from the base config as
# modules and udev loads them on its own. Only what is essential to mount the
# root WITHOUT an initramfs (OSYR uses none) is built in (=y).
# =============================================================================

# --- Identity and quiet boot -------------------------------------------------
CONFIG_LOCALVERSION="-osyr"
CONFIG_DEFAULT_HOSTNAME="osyr"
CONFIG_KERNEL_ZSTD=y
# CONFIG_LOGO is not set

# --- Latency (voice) and low-RAM performance (local AI in 8 GB) -------------
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZSWAP=y
CONFIG_NUMA=y

# --- systemd, containers and extensions (sysext) ----------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Security ----------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y

# --- Our own boot medium: BIOS and UEFI, no initramfs -----------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Built-in storage: without initramfs, a module means no root -----------
# (newos: booted with an IDE disk and black screen with SATA while ahci was =m)
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# (newos: without xhci-pci built in, a root on a USB stick never shows up)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# --- Test virtual machines (QEMU, VirtualBox) -------------------------------
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VMWGFX=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Ubuntu leftovers that break the build or bloat the kernel -------------
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# (MODULE_SIG cannot be removed: SECURITY_LOCKDOWN_LSM selects it; the kernel
# signs the modules at build time with a key generated on every build)
# No debug info: it is stripped from the image anyway, and it made the kernel
# build ~25 GB. DEBUG_INFO cannot be set to n directly (the "Debug information"
# choice selects it), so pick NONE in that choice. BTF depends on it.
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
