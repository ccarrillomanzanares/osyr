config BR2_PACKAGE_WHISPER_CPP
	bool "whisper-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Local speech recognition (Whisper) on the CPU. Goes in /opt/whisper
	  with its own ggml: llama.cpp's is a different version and the
	  libggml*.so libraries would clash in /usr/lib.

	  https://github.com/ggml-org/whisper.cpp
